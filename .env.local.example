# Supported single-process local runtime. Provider credentials stay server-side.
RAG_PROVIDER=extractive
RAG_MODEL=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_ALLOW_REGISTRATION=true
RAG_SECURE_COOKIES=false
RAG_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
